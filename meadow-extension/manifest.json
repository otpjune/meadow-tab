{
  "manifest_version": 3,
  "name": "Meadow Tab",
  "version": "1.5.2",
  "description": "A calm new tab page: big clock, frosted-glass search, focus timer and wallpaper-matched app icons.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen",
    "favicon",
    "search"
  ],
  "host_permissions": [
    "https://suggestqueries.google.com/*",
    "https://t3.gstatic.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}